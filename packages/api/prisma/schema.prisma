generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  PROVIDER
  ADMIN
}

enum ProfileType {
  INDIVIDUAL
  COMPANY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RequestStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReviewTarget {
  PROVIDER
  REQUESTER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  roles        UserRole[] @default([REQUESTER])
  status       UserStatus @default(ACTIVE)
  profile         Profile?
  requests        ServiceRequest[]
  offers          Offer[]
  requesterJobs   Job[]      @relation("RequesterJobs")
  providerJobs    Job[]      @relation("ProviderJobs")
  reviewsWritten  Review[]   @relation("Reviewer")
  reviewsReceived Review[]   @relation("ReviewedUser")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
}

model Profile {
  id          String      @id @default(cuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ProfileType @default(INDIVIDUAL)
  displayName String
  description String?
  phone       String?
  city        String?
  country     String?
  avatarUrl   String?
  companyName String?
  taxId       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([city])
  @@index([type])
}

model Category {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String?
  parentId        String?
  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryTree")
  attributeSchema Json             @default("[]")
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  requests        ServiceRequest[]

  @@index([parentId])
  @@index([isActive])
}

model ServiceRequest {
  id           String        @id @default(cuid())
  requesterId  String
  requester    User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  title        String
  description  String
  city         String?
  country      String?
  address      String?
  startsAt     DateTime?
  endsAt       DateTime?
  budgetAmount Decimal?      @db.Decimal(12, 2)
  currency     String        @default("EUR")
  status       RequestStatus @default(OPEN)
  attributes   Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  offers       Offer[]
  job          Job?

  @@index([requesterId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model Offer {
  id            String      @id @default(cuid())
  requestId     String
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId    String
  provider      User        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  message       String
  price         Decimal     @db.Decimal(12, 2)
  currency      String      @default("EUR")
  estimatedDays Int?
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  job           Job?

  @@unique([requestId, providerId])
  @@index([providerId])
  @@index([status])
}

model Job {
  id           String     @id @default(cuid())
  offerId      String     @unique
  offer        Offer      @relation(fields: [offerId], references: [id])
  requestId    String     @unique
  request      ServiceRequest @relation(fields: [requestId], references: [id])
  requesterId  String
  requester    User       @relation("RequesterJobs", fields: [requesterId], references: [id])
  providerId   String
  provider     User       @relation("ProviderJobs", fields: [providerId], references: [id])
  price        Decimal    @db.Decimal(12, 2)
  currency     String     @default("EUR")
  status       JobStatus  @default(ACTIVE)
  acceptedAt   DateTime   @default(now())
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviews      Review[]

  @@index([requesterId])
  @@index([providerId])
  @@index([status])
}

model Review {
  id          String       @id @default(cuid())
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User         @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetId    String
  target      User         @relation("ReviewedUser", fields: [targetId], references: [id], onDelete: Cascade)
  targetType  ReviewTarget
  rating      Int
  comment     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([jobId, reviewerId])
  @@index([targetId])
}
